# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Prisma)
# Example local: postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public
# Example Supabase/Neon: postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public"

# Redis Connection (BullMQ Queue)
# Example local: redis://localhost:6379
# Example Upstash (Cloud Redis): rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379
REDIS_URL="redis://localhost:6379"

# (Optional) Custom Ethereal SMTP Credentials
# If not provided, ephemeral Ethereal test accounts are generated automatically on startup
# ETHEREAL_USER=""
# ETHEREAL_PASS=""
