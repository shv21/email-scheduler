# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS & OAuth redirects)
CLIENT_URL="http://localhost:5173"

# Session Security
SESSION_SECRET="change-this-to-a-secure-random-32-byte-secret-in-production"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Go to APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Application type: Web application
# 4. Authorized JavaScript origins: http://localhost:5173 and http://localhost:5000
# 5. Authorized redirect URIs: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# PostgreSQL Connection String (Prisma)
# Example local: postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public
# Example Supabase/Neon: postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/email_scheduler?schema=public"

# Redis Connection (BullMQ Queue & Rate Limiting)
# Example local: redis://localhost:6379
# Example Upstash (Cloud Redis): rediss://default:[YOUR-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379
REDIS_URL="redis://localhost:6379"

# Rate Limiting Configuration
# Hourly email dispatch limit per sender
HOURLY_EMAIL_LIMIT=1
DEFAULT_SENDER="sender@example.com"

# Slack Webhook Alert Configuration (Optional)
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX"

# (Optional) Custom Ethereal SMTP Credentials
# If not provided, ephemeral Ethereal test accounts are generated automatically on startup
# ETHEREAL_USER=""
# ETHEREAL_PASS=""
